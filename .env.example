# ---- Supabase (server-side only; the service key bypasses RLS, never ship it to a browser) ----
SUPABASE_URL=https://rrbivwhratkmzcfxqjih.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Claude Code (the local runner only; there is no API key in this project) ----
# The runner shells out to the `claude` CLI, so it runs on whatever account `claude` is logged
# into. Run `claude` once interactively to log in before starting the runner.
CLAUDE_MODEL=sonnet          # sonnet | opus | haiku, or a full model id
# CLAUDE_BIN=/usr/local/bin/claude   # only if `claude` is not on PATH
# CLAUDE_MAX_TURNS=12

# ---- Telegram intake ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# chat ids allowed to edit (comma separated); rows in telegram_users work too
TELEGRAM_ADMIN_IDS=
# chat id that receives failure and usage-limit alerts (optional)
TELEGRAM_ALERT_CHAT_ID=

# ---- Display access: the wall opens /?key=<DISPLAY_KEY>. Leave empty for open access. ----
DISPLAY_KEY=

# ---- Runner cadence, in seconds (defaults shown) ----
INTAKE_EVERY_SEC=45
COLLECT_EVERY_SEC=600
ENRICH_EVERY_SEC=600
LAUNCHES_EVERY_SEC=900
WEATHER_EVERY_SEC=1800
NUMBERS_AT=01:30             # Israel time, once a day
ENRICH_BATCH=12              # items per Claude Code call
MODEL_BACKOFF_MIN=30         # pause after hitting a usage limit; doubles up to MODEL_BACKOFF_MAX_MIN
MODEL_BACKOFF_MAX_MIN=240
