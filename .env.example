# ---- Supabase (server-side only; never ship the service key to the browser) ----
SUPABASE_URL=https://rrbivwhratkmzcfxqjih.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Anthropic ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# ---- Display access: the wall calls /api/feed?key=<DISPLAY_KEY>. Leave empty to allow open access. ----
DISPLAY_KEY=

# ---- Telegram intake ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# chat ids allowed to edit (comma separated); rows in telegram_users also work
TELEGRAM_ADMIN_IDS=
# chat id that receives agent failure alerts (optional)
TELEGRAM_ALERT_CHAT_ID=

# ---- Agent tuning ----
OSINT_MAX_ITEMS=40
OSINT_WEB_SEARCH=0
