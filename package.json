{
  "name": "space-wall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Space Wall: lobby display (app/), feed + Telegram API (api/), local runner on Claude Code (agent/)",
  "scripts": {
    "runner": "tsx agent/src/runner.ts",
    "doctor": "tsx agent/src/index.ts doctor",
    "agent": "tsx agent/src/index.ts",
    "feed:preview": "tsx agent/src/index.ts feed",
    "typecheck": "tsc --noEmit",
    "dev": "vercel dev",
    "test": "tsx agent/test/bridge.test.mts",
    "agent:cloud": "bash scripts/cloud-run.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "rss-parser": "^3.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vercel/node": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
